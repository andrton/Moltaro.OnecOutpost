<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Every test here has Requires=Windows, so the Linux job of CI, which leaves those out, runs none of them, and
         Microsoft.Testing.Platform ends a run of zero tests with exit code 8. This project alone accepts that code; any
         other project that runs no test still fails the job. The platform's targets add these arguments to
         RunArguments, which dotnet test reads in its Microsoft.Testing.Platform mode. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moltaro.OnecOutpost.ComWorker\Moltaro.OnecOutpost.ComWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
