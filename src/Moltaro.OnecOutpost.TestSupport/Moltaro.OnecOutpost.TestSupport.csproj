<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code that more than one test project needs. Never shipped; it holds no tests. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The loopback server is a node of the server as an application embeds it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server carries the protocol assembly without passing it on (PQ6); the test agent of the loopback server is
         made of its internal types, so this project references it itself. -->
    <ProjectReference Include="..\Moltaro.OnecOutpost.Protocol\Moltaro.OnecOutpost.Protocol.csproj" />
    <ProjectReference Include="..\Moltaro.OnecOutpost.Server\Moltaro.OnecOutpost.Server.csproj" />
    <!-- The launcher that reports what the workers did wraps the agent's boundary of the COM workers, for the agent's
         tests and the lab's; the fakes of the data folder, the access lists, the protection and the server stand in
         for the agent's boundaries, in the agent's tests and the console's. -->
    <ProjectReference Include="..\Moltaro.OnecOutpost.Agent\Moltaro.OnecOutpost.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The helpers of the loopback server assert what came back, as the tests that use them do. -->
    <PackageReference Include="xunit.v3.assert" />
    <!-- The fakes of the data folder and of the server wait within the token of the test that runs, TestContext's. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The helpers of the loopback server and of the workers are made of the internal types of the server, the agent
         and the protocol, so they are internal too, for the test projects that use them and the measurement program. -->
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.Server.Tests" />
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.Agent.Tests" />
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.Console.Tests" />
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.Shell.Tests" />
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.OneC.Tests" />
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.Measurements" />
  </ItemGroup>

</Project>
