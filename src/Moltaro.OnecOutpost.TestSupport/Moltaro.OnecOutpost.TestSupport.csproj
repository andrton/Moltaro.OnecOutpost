<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code that more than one test project needs. Never shipped; it holds no tests. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The loopback server is a node of the server as an application embeds it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server carries the protocol assembly without passing it on (PQ6); the test agent of the loopback server is
         made of its internal types, so this project references it itself. -->
    <ProjectReference Include="..\Moltaro.OnecOutpost.Protocol\Moltaro.OnecOutpost.Protocol.csproj" />
    <ProjectReference Include="..\Moltaro.OnecOutpost.Server\Moltaro.OnecOutpost.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The helpers of the loopback server assert what came back, as the tests that use them do. -->
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

  <ItemGroup>
    <!-- The helpers of the loopback server are made of the internal types of the server and the protocol, so they are
         internal too, for the test projects that use them. -->
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.Server.Tests" />
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.Agent.Tests" />
  </ItemGroup>

</Project>
