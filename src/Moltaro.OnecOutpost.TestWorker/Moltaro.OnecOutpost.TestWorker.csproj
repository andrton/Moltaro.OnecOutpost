<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test program that stands in for the COM worker in the agent's tests with Requires=Windows: it speaks the
       worker's lines, command line and exit codes without 1C. A program of the tests, never shipped; nothing outside
       .NET. The tests of the agent reference it, so that it is built and copied next to them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
