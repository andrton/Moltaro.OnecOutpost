<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test program that stands in for the COM worker in the agent's and the console's tests with Requires=Windows:
       it speaks the worker's lines, command line and exit codes without 1C. A program of the tests, never shipped;
       nothing outside .NET. Those tests reference it, so that it is built and copied next to them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The marshalling that LibraryImport generates for the calls that report the job, the account and an inherited
         handle is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
