<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A program of the agent archive, never a package. -->
    <IsPackable>false</IsPackable>
    <!-- LibraryImport generates unsafe code for every call to Windows, and the service, DPAPI, the launcher, the desktop and the readers of a token use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moltaro.OnecOutpost.Protocol\Moltaro.OnecOutpost.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The agent has no public surface: its tests address its types directly. -->
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.Agent.Tests" />
    <!-- TestSupport wraps the boundary of the COM workers, and the lab's tests run the agent against a real 1C. -->
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.TestSupport" />
    <InternalsVisibleTo Include="Moltaro.OnecOutpost.OneC.Tests" />
  </ItemGroup>

</Project>
