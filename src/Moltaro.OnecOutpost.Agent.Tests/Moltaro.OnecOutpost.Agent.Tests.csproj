<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport generates unsafe code for AnonymousLogon, TestTokens and TestDesktop, and the last two read
         native structures through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moltaro.OnecOutpost.Agent\Moltaro.OnecOutpost.Agent.csproj" />
    <ProjectReference Include="..\Moltaro.OnecOutpost.TestSupport\Moltaro.OnecOutpost.TestSupport.csproj" />
    <!-- The test program that stands in for the COM worker: the reference builds it and copies it, with its
         runtimeconfig.json, next to the tests, which start it only as a process and use none of its types. -->
    <ProjectReference Include="..\Moltaro.OnecOutpost.TestWorker\Moltaro.OnecOutpost.TestWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
